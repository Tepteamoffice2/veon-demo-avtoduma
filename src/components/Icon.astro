---
// One line icon set (24 grid, 2 px stroke). Always decorative: the control carries the text.
type Name = "viber" | "telegram" | "phone" | "search" | "menu" | "close" | "mail" | "route";
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
const paths: Record<Name, string[]> = {
  viber: [
    "M12 3.2c5 0 8.6 2.5 8.6 7.5s-3.6 7.4-8.6 7.4c-.9 0-1.7-.1-2.5-.2L6 20.6v-3.4c-1.6-1.3-2.6-3.4-2.6-6.5C3.4 5.7 7 3.2 12 3.2z",
    "M9.3 7.6c-.4.3-.6.8-.4 1.4.6 2 2.2 3.6 4.2 4.3.6.2 1.1 0 1.4-.4l.5-.6-1.6-1.1-.7.5c-.8-.4-1.4-1-1.8-1.8l.5-.7-1.1-1.6z",
  ],
  telegram: ["M21 4.5 3 11.6l6 2.1 2.2 6.3 3.3-4 4.5 3.4L21 4.5z", "M9 13.7 17.6 8"],
  phone: ["M5.5 3.5h3l1.6 4.4-2.1 1.4a11.5 11.5 0 0 0 6.7 6.7l1.4-2.1 4.4 1.6v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2z"],
  search: ["M10.5 3.5a7 7 0 1 1 0 14 7 7 0 0 1 0-14z", "m15.6 15.6 5 5"],
  menu: ["M3.5 7h17", "M3.5 12h17", "M3.5 17h17"],
  close: ["m5.5 5.5 13 13", "m18.5 5.5-13 13"],
  mail: ["M3.5 5.5h17v13h-17z", "m3.5 6.5 8.5 6.5 8.5-6.5"],
  route: ["M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z", "M12 7.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z"],
};
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>
